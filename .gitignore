# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore
# ...except the CI key, which is committed on purpose so that every build installs over
# the previous one instead of demanding an uninstall. Its password is published in
# ci/README.md; it is not, and must never become, a release key.
!ci/opennav-ci.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Generated chart archives. Built by tools/, never committed: the real ones are hundreds
# of megabytes and their licence wants an attribution only the app can carry.
*.pmtiles

# ...except the demo shipped inside the APK, which is committed on purpose. It is a few
# megabytes of invented seabed, it changes about never, and the alternative -- generating
# it during the build -- would make a working APK depend on having Python on the machine
# and would quietly produce an app that opens on an empty screen when it is missing.
# Regenerate with the command in tools/README.md; it takes about two minutes.
!app/src/main/assets/*.pmtiles

# Python
__pycache__/
*.pyc
.venv/
