<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Same reasoning as backup_rules.xml: include the profile, and nothing else
         travels. Chart archives stay on the device that downloaded them. -->
    <cloud-backup>
        <include domain="sharedpref" path="opennav.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="opennav.xml" />
    </device-transfer>
</data-extraction-rules>
