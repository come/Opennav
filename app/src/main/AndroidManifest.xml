<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Opennav works with the radio off. INTERNET is removed, and that is the guarantee
        that matters: without it the process cannot open a socket, whatever any library
        inside it decides to try. The MapLibre SDK declares it for the online tile sources
        we do not use.

        ACCESS_NETWORK_STATE is NOT removed, and that is deliberate. It grants no data
        path -- it only permits asking the system whether a network exists -- and MapLibre
        asks that question inside MapLibre.getInstance(), during Application.onCreate.
        Removing it turned the first line of the app into a SecurityException, which is
        the worst possible place for one. Keeping a permission that cannot carry a byte is
        a smaller price than an app that will not start.

        If a future feature genuinely needs the network (downloading a chart pack, say),
        put it behind an explicit user action and re-add INTERNET with a comment saying
        which feature needs it.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:name=".OpennavApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Opennav">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Opennav">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
