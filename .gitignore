# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore
# ...except the CI key, which is committed on purpose so that every build installs over
# the previous one instead of demanding an uninstall. Its password is published in
# ci/README.md; it is not, and must never become, a release key.
!ci/opennav-ci.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# OpenStreetMap extracts. The source the base map and buoyage are built from, downloaded
# from Geofabrik -- hundreds of megabytes, and re-fetchable, so never committed.
*.osm.pbf

# Generated chart archives. Built by tools/, never committed: the real ones are hundreds
# of megabytes and their licence wants an attribution only the app can carry.
*.pmtiles

# ...except the charts shipped inside the APK, which are committed on purpose: the default
# Brittany base map and buoyage the app opens on, plus the synthetic demo seabed. All are
# vector or invented -- single-digit megabytes, changing about never -- where a real
# bathymetry survey, hundreds of megabytes, never could be. The alternative, generating
# them during the build, would make a working APK depend on having Python on the machine
# and would quietly produce an app that opens on an empty screen when it is missing.
# Regenerate with the commands in tools/README.md.
!app/src/main/assets/*.pmtiles

# Python
__pycache__/
*.pyc
.venv/
